{
  "name": "crawl4ai-stats",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // No public *.workers.dev / preview URLs: serve only on your own domain behind Cloudflare Access
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
